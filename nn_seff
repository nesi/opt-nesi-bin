#!/usr/bin/python3

# This script is roughtly equivalent to:
# sacct -P -n -a --format JobID,User,State,Cluster,AllocCPUS,REQMEM,TotalCPU,Elapsed,MaxRSS,NNodes,NTasks -j <job_id>

import sys, getopt, json, subprocess

# Convert elapsed time to string.
def time2str(seconds):
    (minutes, seconds) = divmod(int(seconds), 60)
    (hours, minutes) = divmod(minutes, 60)
    (days, hours) = divmod(hours, 24)
    days = '' if days < 1 else f'{days}-'
    return days + "{:02}:{:02}:{:02}".format(hours, minutes, seconds)

# Convert memory to human-readable string.
def kbytes2str(kbytes):
    from math import log
    if kbytes == 0:
        return "%.2f %sB" % (0.0, 'M')
    mul = 1024
    exp = int(log(kbytes) / log(mul))
    pre = "kMGTPE "[exp]
    return "%.2f %sB" % (kbytes / mul**exp, pre.strip())

def sacct(*args):
    p = subprocess.run(['sacct', '--json=data_parser/v0.0.43'] + list(args),
            stdout=subprocess.PIPE, timeout=30, check=True)
    return json.loads(p.stdout)

def ex_tres(objs, name, default=None, field='count'):
    tres = {m['name' if m['type']=='gres' else 'type']: m[field] for m in objs}
    return tres.get(name, default)

(opts, args) = getopt.getopt(sys.argv[1:], 'hvdfj:M:')
opts = dict(opts)

if 'v' in opts:
    print("NeSI version of seff")
    sys.exit(1)
if 'h' in opts or not (args or '-j' in opts):
    print("Usage: seff [Options] <JobID>")
    print("       Options:")
    print("       -M    Cluster")
    print("       -h    Help")
    print("       -j    JobID")
    print("       -v    Version")
    sys.exit(1)

if '-M' in opts:
    clusteropts = ['-M', opts['-M']]
else:
    clusteropts = []

if '-j' in opts:
    job_ids = [opts['-j']]
else:
    job_ids = []
job_ids.extend(args)

sacct_args = clusteropts + ['-j', ','.join(job_ids)]

jobs = sacct(*sacct_args)["jobs"]

if len(jobs) < 1:
    print("Job not found.", file=sys.stderr)
    sys.exit(2)

preceded = False
for job in jobs:
    if preceded:
        print()
    preceded = True

    jobid = job['job_id']
    user = job['association']['user']
    state = ' '.join(job['state']['current'])
    ncpus = ex_tres(job['tres']['allocated'], 'cpu', 0)

    if state=="RUNNING" or ncpus == 0 or 'fffffff' in hex(ncpus):
        print(f"Efficiency not available for {state} jobs.")
        continue
    ncores = (ncpus+1) // 2

    clustername = job['cluster']
    nnodes = job['allocation_nodes']

    reqmem = ex_tres(job['tres']['allocated'], 'mem') * 1024
    walltime = job['time']['elapsed']
    timelimit = job['time']['limit']['number'] * 60
    #exit_status = "{return_code} ({status})".format(**job['exit_code'])

    array_job_id = job['array']['job_id']
    if array_job_id != 0:
        array_task_id = job['array']['task_id']['number']
        array_jobid = f"{array_job_id}_{array_task_id}"
    else:
        array_jobid = ""

    # Count the job steps
    _step_id_suffixes = [step['step']['id'].split(".")[-1] for step in job['steps']]
    has_batch_step = any(suffix.endswith('.batch') for suffix in _step_id_suffixes)
    ordinary_batch_steps = sum(1 for suffix in _step_id_suffixes if suffix.isdigit())

    # Collect the job step start and end events.
    events = []
    for step in job['steps']:
        start = step['time']['start']['number']
        end = step['time']['end']['number']
        step_id = step['step']['id']
        if end > start:
            events.append((start, True, step_id, step))
            events.append((end, False, step_id, step))

    # Find peaks over time for mem, ntasks, and GPU utilisation, summing across any overlapping job steps.
    current_steps = {}
    current = {'ntasks': 0, 'mem': 0, 'gpuutil': 0, 'gpumem': 0}
    peak = {'ntasks': 0, 'mem': 0}
    peak_steps = {}
    for (when, starting, step_id, step) in sorted(events):
        used = step['tres']['requested']['total']
        if starting:
            current_steps[step_id] = step
            direction = 1
        else:
            current_steps.pop(step_id)
            direction = -1
        for (key, delta) in {
                'ntasks': (0 if (step_id.endswith('batch') or step_id.endswith('extern'))  else step['tasks']['count']),
                'mem': ex_tres(used, 'mem', 0) / 1024,
                'gpuutil': ex_tres(used, 'gpuutil', None),
                'gpumem': ex_tres(used, 'gpumem', None)}.items():
            if delta is not None:
                current[key] += direction * delta
                if current[key] > peak.get(key, 0):
                    peak[key] = current[key]
                    peak_steps[key] = current_steps.copy()

    print("Cluster:", clustername)
    print("Job ID:", jobid)
    if array_jobid:
        print("Array Job ID:", array_jobid)
    print("State:", state)
    if ordinary_batch_steps > 1:
        print("Steps:", ("batch + " if has_batch_step else "") + str(ordinary_batch_steps))
    if peak['ntasks'] > 0:
        print("Tasks:", peak['ntasks'])
    print("Cores:", ncores)
    if nnodes > 1 or peak['ntasks'] > 1:
        print("Nodes:", nnodes)

    # Walltime and CPU time
    corewalltime = walltime * ncores
    tot_cpu_msec = sum(ex_tres(step['tres']['requested']['total'], 'cpu', 0) for step in job['steps'])
    if corewalltime:
        cpu_eff = tot_cpu_msec / 1000 / corewalltime * 100
    else:
        cpu_eff = 0.0

    print("Job Wall-time:   {: >5.1f}%  {} of {} time limit".format(
        100*walltime/timelimit, time2str(walltime), time2str(timelimit)))
    print("CPU Utilisation: {: >5.1f}%  {} of {} core-walltime".format(
        cpu_eff, time2str(tot_cpu_msec/1000), time2str(corewalltime)))

    # Total Memory
    mem_eff = (peak['mem'] / reqmem * 100) if reqmem else 0.0
    print("Mem Utilisation: {: >5.1f}%  {} of {}".format(mem_eff, *map(kbytes2str, [peak['mem'], reqmem])), end='')

    # Per-task memory details
    (mem_ntasks, max_mem, min_mem, peak_mem_steps) = (0, 0, 1e12, 0)
    for (step_id, step) in peak_steps['mem'].items():
        if ex_tres(step['tres']['requested']['total'], 'mem', 0) < peak['mem']/10:
            continue  # ignore small steps, eg: probably the batch step.
        step_usage = step['tres']['requested']
        mem_ntasks += step['tasks']['count']
        min_mem = min(min_mem, ex_tres(step_usage['min'], 'mem', 0))
        max_mem = max(max_mem, ex_tres(step_usage['max'], 'mem', min_mem))
        pernode = ex_tres(step_usage['max'], 'mem', 0, field='task') == -1  # can trust this is constant within a job?
        peak_mem_steps += 1
    if mem_ntasks == 1:
        print()
    else:
        (denom, desc) = (nnodes, 'node') if pernode else (mem_ntasks, 'task')
        print(" ({} to {}".format(kbytes2str(min_mem/1024), kbytes2str(max_mem/1024), desc=desc), end=' ')
        if peak_mem_steps == 1:
            print("of {}/{desc})".format(kbytes2str(reqmem / denom), desc=desc))
        else:
            print("in each of {} tasks from {} job steps)".format(mem_ntasks, peak_mem_steps))

    # GPUs
    if (gpuutil := peak.get('gpuutil')) is not None:
        print("GPU Utilisation: {: >3.0f}  %".format(gpuutil))
    if (gpumem := peak.get('gpumem')) is not None:
        a100_gb = 40 if job['partition'] == 'genoa' else 80
        alloc = sum(mem * ex_tres(job['tres']['allocated'], 'gpu:'+kind, 0) for (kind, mem) in [('l4', 23), ('a100', a100_gb), ('h100', 94)])
        if alloc:
            print("GPU Memory:      {: >5.1f}%  {} of {} GB".format(100*gpumem/(alloc*(1024**3)), kbytes2str(gpumem/1024), alloc))
        else:
            print("GPU Memory:", " "*12, kbytes2str(gpumem/1024))
